  "settingsFaqSectionGettingStarted": "Getting Started",
  "@settingsFaqSectionGettingStarted": {
    "description": "Help screen FAQ section heading."
  },
  "settingsFaq01Question": "How do I add a transaction?",
  "@settingsFaq01Question": {
    "description": "Help screen FAQ question (Getting Started)."
  },
  "settingsFaq01Answer": "Tap the + button at the bottom of the home screen. Fill in the amount, select a category, choose a wallet, and optionally add notes. Tap Save to record your transaction.",
  "@settingsFaq01Answer": {
    "description": "Help screen FAQ answer to: How do I add a transaction?"
  },
  "settingsFaq02Question": "What is the difference between wallets and categories?",
  "@settingsFaq02Question": {
    "description": "Help screen FAQ question (Getting Started)."
  },
  "settingsFaq02Answer": "Wallets represent where your money is stored (e.g., Cash, Bank Account, Credit Card). Categories describe what the money was spent on or where it came from (e.g., Food, Salary, Entertainment).",
  "@settingsFaq02Answer": {
    "description": "Help screen FAQ answer to: What is the difference between wallets and categories?"
  },
  "settingsFaq03Question": "How do I customize my date and number format?",
  "@settingsFaq03Question": {
    "description": "Help screen FAQ question (Getting Started)."
  },
  "settingsFaq03Answer": "Go to Settings > Regional Settings. You can change your default currency, date format (e.g., DD/MM/YYYY or MM/DD/YYYY), and number format (e.g., 1,234.56 or 1.234,56). A live preview shows how your settings will look.",
  "@settingsFaq03Answer": {
    "description": "Help screen FAQ answer to: How do I customize my date and number format?"
  },
  "settingsFaqSectionTransactions": "Transactions",
  "@settingsFaqSectionTransactions": {
    "description": "Help screen FAQ section heading."
  },
  "settingsFaq04Question": "Can I track recurring transactions?",
  "@settingsFaq04Question": {
    "description": "Help screen FAQ question (Transactions)."
  },
  "settingsFaq04Answer": "Yes! When adding a transaction, enable the \"Recurring\" option. You can set it to repeat daily, weekly, monthly, or yearly. The app will automatically create these transactions for you.",
  "@settingsFaq04Answer": {
    "description": "Help screen FAQ answer to: Can I track recurring transactions?"
  },
  "settingsFaq05Question": "How do I transfer money between wallets?",
  "@settingsFaq05Question": {
    "description": "Help screen FAQ question (Transactions)."
  },
  "settingsFaq05Answer": "When adding a transaction, select \"Transfer\" as the type. Choose the source wallet, destination wallet, and enter the amount. The app will automatically deduct from one and add to the other.",
  "@settingsFaq05Answer": {
    "description": "Help screen FAQ answer to: How do I transfer money between wallets?"
  },
  "settingsFaq06Question": "What are upcoming transactions?",
  "@settingsFaq06Question": {
    "description": "Help screen FAQ question (Transactions)."
  },
  "settingsFaq06Answer": "Upcoming transactions are future expenses or income you expect but haven't paid yet. They won't affect your wallet balance until you mark them as paid. You can find overdue and upcoming items in the transactions section.",
  "@settingsFaq06Answer": {
    "description": "Help screen FAQ answer to: What are upcoming transactions?"
  },
  "settingsFaq07Question": "How do I track subscriptions?",
  "@settingsFaq07Question": {
    "description": "Help screen FAQ question (Transactions)."
  },
  "settingsFaq07Answer": "When adding a transaction, set the special type to Subscription. This marks it as a recurring service payment. You can view all your subscriptions in one place and track your monthly subscription spending.",
  "@settingsFaq07Answer": {
    "description": "Help screen FAQ answer to: How do I track subscriptions?"
  },
  "settingsFaq08Question": "How does credit and debt tracking work?",
  "@settingsFaq08Question": {
    "description": "Help screen FAQ question (Transactions)."
  },
  "settingsFaq08Answer": "Use Credit to track money you've lent to someone, and Debt to track money you've borrowed. Each entry tracks the amount, who owes whom, and payment progress. You can record partial payments and mark debts as settled when fully repaid.",
  "@settingsFaq08Answer": {
    "description": "Help screen FAQ answer to: How does credit and debt tracking work?"
  },
  "settingsFaq09Question": "Can I add notes or receipts to transactions?",
  "@settingsFaq09Question": {
    "description": "Help screen FAQ question (Transactions)."
  },
  "settingsFaq09Answer": "Yes! When adding or editing a transaction, you can type notes in the notes field. Premium users can also scan receipts using the AI-powered receipt scanner, which automatically extracts the amount and merchant details.",
  "@settingsFaq09Answer": {
    "description": "Help screen FAQ answer to: Can I add notes or receipts to transactions?"
  },
  "settingsFaqSectionWalletsCurrencies": "Wallets & Currencies",
  "@settingsFaqSectionWalletsCurrencies": {
    "description": "Help screen FAQ section heading."
  },
  "settingsFaq10Question": "How do I manage multiple wallet accounts?",
  "@settingsFaq10Question": {
    "description": "Help screen FAQ question (Wallets & Currencies)."
  },
  "settingsFaq10Answer": "The app supports four account types: Cash, Bank Account, Credit Card, and Subscription. To add a new account, go to 'Your Accounts' on the dashboard and tap 'Add Account'. Each account can have its own name, icon, color, and currency. Your first account is automatically set as the default. Credit card accounts also let you set a credit limit and billing cycle day so you can track available credit.",
  "@settingsFaq10Answer": {
    "description": "Help screen FAQ answer to: How do I manage multiple wallet accounts?"
  },
  "settingsFaq11Question": "Can I use multiple currencies?",
  "@settingsFaq11Question": {
    "description": "Help screen FAQ question (Wallets & Currencies)."
  },
  "settingsFaq11Answer": "Yes! Each wallet can have its own currency. The app supports automatic currency conversion using live exchange rates. You can also set custom exchange rates in Settings > Regional Settings.",
  "@settingsFaq11Answer": {
    "description": "Help screen FAQ answer to: Can I use multiple currencies?"
  },
  "settingsFaq12Question": "How does currency conversion work?",
  "@settingsFaq12Question": {
    "description": "Help screen FAQ question (Wallets & Currencies)."
  },
  "settingsFaq12Answer": "Each wallet can have a different currency, and the app automatically converts amounts using live exchange rates updated every few hours. You can also set custom exchange rates for any currency pair in Settings > Regional Settings. The app supports over 150 currencies with automatic rate fetching.",
  "@settingsFaq12Answer": {
    "description": "Help screen FAQ answer to: How does currency conversion work?"
  },
  "settingsFaq13Question": "What happens if I delete a category with transactions?",
  "@settingsFaq13Question": {
    "description": "Help screen FAQ question (Wallets & Currencies)."
  },
  "settingsFaq13Answer": "Those transactions will be moved to \"Uncategorized\". You can then reassign them to a different category or leave them uncategorized.",
  "@settingsFaq13Answer": {
    "description": "Help screen FAQ answer to: What happens if I delete a category with transactions?"
  },
  "settingsFaq14Question": "What are subcategories and how do I use them?",
  "@settingsFaq14Question": {
    "description": "Help screen FAQ question (Wallets & Currencies)."
  },
  "settingsFaq14Answer": "You can create subcategories under any main category for more detailed tracking. For example, under 'Food', you could have 'Groceries', 'Restaurants', and 'Coffee'. Subcategories help you see exactly where your money goes.",
  "@settingsFaq14Answer": {
    "description": "Help screen FAQ answer to: What are subcategories and how do I use them?"
  },
  "settingsFaq15Question": "What is a balance correction?",
  "@settingsFaq15Question": {
    "description": "Help screen FAQ question (Wallets & Currencies)."
  },
  "settingsFaq15Answer": "A balance correction lets you adjust a wallet's balance when it doesn't match the actual amount. This creates a special transaction that brings your tracked balance in line with reality, without manually adding income or expense entries.",
  "@settingsFaq15Answer": {
    "description": "Help screen FAQ answer to: What is a balance correction?"
  },
  "settingsFaqSectionBudgetsGoals": "Budgets & Goals",
  "@settingsFaqSectionBudgetsGoals": {
    "description": "Help screen FAQ section heading."
  },
  "settingsFaq16Question": "How do I set up a budget?",
  "@settingsFaq16Question": {
    "description": "Help screen FAQ question (Budgets & Goals)."
  },
  "settingsFaq16Answer": "Go to the Budgets tab and tap \"Create Budget\". Choose a name, set your spending limit, select the time period (weekly/monthly), and pick which categories to track. The app will alert you when you approach your limit.",
  "@settingsFaq16Answer": {
    "description": "Help screen FAQ answer to: How do I set up a budget?"
  },
  "settingsFaq17Question": "What are savings goals?",
  "@settingsFaq17Question": {
    "description": "Help screen FAQ question (Budgets & Goals)."
  },
  "settingsFaq17Answer": "Savings goals let you set a target amount you want to save. Create a goal in the Objectives section, set your target, and link transactions to track your progress. The app shows a progress bar and percentage toward your target.",
  "@settingsFaq17Answer": {
    "description": "Help screen FAQ answer to: What are savings goals?"
  },
  "settingsFaq18Question": "How do I track a loan?",
  "@settingsFaq18Question": {
    "description": "Help screen FAQ question (Budgets & Goals)."
  },
  "settingsFaq18Answer": "Create a Loan objective in the Objectives section with the total amount owed. As you make payments, link those transactions to the loan to track your repayment progress. The app shows how much you've paid and what remains.",
  "@settingsFaq18Answer": {
    "description": "Help screen FAQ answer to: How do I track a loan?"
  },
  "settingsFaqSectionDataSync": "Data & Sync",
  "@settingsFaqSectionDataSync": {
    "description": "Help screen FAQ section heading."
  },
  "settingsFaq19Question": "How does Cloud Sync work?",
  "@settingsFaq19Question": {
    "description": "Help screen FAQ question (Data & Sync)."
  },
  "settingsFaq19Answer": "Cloud Sync keeps your data synchronized across devices. Go to Settings > Data Management > Cloud Sync to enable it. Sync runs automatically every 15 minutes and when you open the app. You can also tap 'Sync Now' for an immediate sync. This is a Premium feature.",
  "@settingsFaq19Answer": {
    "description": "Help screen FAQ answer to: How does Cloud Sync work?"
  },
  "settingsFaq20Question": "How do I export my data?",
  "@settingsFaq20Question": {
    "description": "Help screen FAQ question (Data & Sync)."
  },
  "settingsFaq20Answer": "Go to Settings > Data Management > Export Data. Choose a date range, select CSV (for spreadsheets) or PDF (for a formatted report), and tap Export. You can include or exclude category and wallet breakdowns. This is a Premium feature.",
  "@settingsFaq20Answer": {
    "description": "Help screen FAQ answer to: How do I export my data?"
  },
  "settingsFaq21Question": "What happens if I clear my data?",
  "@settingsFaq21Question": {
    "description": "Help screen FAQ question (Data & Sync)."
  },
  "settingsFaq21Answer": "Go to Settings > Privacy & Security. 'Clear Cache' removes temporary data and forces a re-sync without deleting your transactions. 'Clear All Data' permanently deletes everything — you'll need to type DELETE to confirm. This action cannot be undone.",
  "@settingsFaq21Answer": {
    "description": "Help screen FAQ answer to: What happens if I clear my data?"
  },
  "settingsFaqSectionPremiumAiFeatures": "Premium & AI Features",
  "@settingsFaqSectionPremiumAiFeatures": {
    "description": "Help screen FAQ section heading."
  },
  "settingsFaq22Question": "What features are included in Premium?",
  "@settingsFaq22Question": {
    "description": "Help screen FAQ question (Premium & AI Features)."
  },
  "settingsFaq22Answer": "Premium unlocks: unlimited AI (the coach, monthly summaries, receipt reading and Describe it) with no ads, Cloud Sync, PDF reports, Premium Themes, and removes limits on wallets, categories, budgets, goals, and payment methods. You also get priority support.",
  "@settingsFaq22Answer": {
    "description": "Help screen FAQ answer to: What features are included in Premium?"
  },
  "settingsFaq23Question": "What are the free tier limits?",
  "@settingsFaq23Question": {
    "description": "Help screen FAQ question (Premium & AI Features)."
  },
  "settingsFaq23Answer": "Free users can create up to 3 wallets, 10 custom categories, 3 active budgets, 2 active goals/loans, and 5 payment methods. Upgrading to Premium removes all these limits.",
  "@settingsFaq23Answer": {
    "description": "Help screen FAQ answer to: What are the free tier limits?"
  },
  "settingsFaq24Question": "What can the AI Assistant do?",
  "@settingsFaq24Question": {
    "description": "Help screen FAQ question (Premium & AI Features)."
  },
  "settingsFaq24Answer": "The money coach answers questions about your own money: where it went, whether you are on track with your budgets and goals, which bills are coming, and how to spend less or save more. It sees a summary of your figures (totals, categories, budgets, goals, bills and recent transactions) so its answers use your real numbers, and it suggests follow-up questions after each reply. It gives general guidance, not professional financial advice. Your conversations are saved so you can pick up where you left off, and you can delete them at any time.",
  "@settingsFaq24Answer": {
    "description": "Help screen FAQ answer to: What can the AI Assistant do?"
  },
  "settingsFaq25Question": "How do AI Insights work?",
  "@settingsFaq25Question": {
    "description": "Help screen FAQ question (Premium & AI Features)."
  },
  "settingsFaq25Answer": "The monthly summary (Stats > Spending Insights) shows this month against last month: what you earned and spent, and how each category moved. Tap Write my summary and the AI picks out what stood out and suggests one thing to try. The numbers are free for everyone; the AI write-up uses one AI request.",
  "@settingsFaq25Answer": {
    "description": "Help screen FAQ answer to: How do AI Insights work?"
  },
  "settingsFaq26Question": "What is Smart Categorization?",
  "@settingsFaq26Question": {
    "description": "Help screen FAQ question (Premium & AI Features)."
  },
  "settingsFaq26Answer": "When you file a transaction by hand, the app remembers which category that title belongs to and picks it for you next time (you can see and edit these under Naming rules). For something new, tap the sparkle button on the add screen and Describe it: type something like 'lunch 250 yesterday from bKash' and the AI fills in the amount, date, category and account for you to check.",
  "@settingsFaq26Answer": {
    "description": "Help screen FAQ answer to: What is Smart Categorization?"
  },
  "settingsFaq27Question": "How does the AI receipt scanner work?",
  "@settingsFaq27Question": {
    "description": "Help screen FAQ question (Premium & AI Features)."
  },
  "settingsFaq27Answer": "Take or pick a photo of a receipt. Your phone reads the text on the device and suggests the merchant and total. Tap Read with AI and the AI works out the real total, the date, each item and the right category, even on a messy receipt; only the text is sent, never the photo. You can review and edit before saving. Reading with AI uses one AI request.",
  "@settingsFaq27Answer": {
    "description": "Help screen FAQ answer to: How does the AI receipt scanner work?"
  },
  "settingsFaq28Question": "How many AI requests do I get, and what are the ads for?",
  "@settingsFaq28Question": {
    "description": "Help screen FAQ question (Premium & AI Features)."
  },
  "settingsFaq28Answer": "Everyone gets 10 free AI requests a month, and they come back on the 1st. If you want more, you can choose to watch a short ad for one extra request, up to 10 more a month. Ads can also unlock a 24-hour premium theme trial or a PDF export. An ad only ever plays after you tap a button and confirm; there are no banner ads and nothing appears on its own. Premium members get unlimited AI and everything else with no ads at all.",
  "@settingsFaq28Answer": {
    "description": "Help screen FAQ answer to: How many AI requests do I get, and what are the ads for?"
  },
  "settingsFaq29Question": "How do I manage my Premium purchase?",
  "@settingsFaq29Question": {
    "description": "Help screen FAQ question (Premium & AI Features)."
  },
  "settingsFaq29Answer": "Premium purchases are managed through Google Play. Go to your Google Play subscription settings to view or manage your plan. Premium is available as a monthly, yearly, or one-time lifetime purchase.",
  "@settingsFaq29Answer": {
    "description": "Help screen FAQ answer to: How do I manage my Premium purchase?"
  },
  "settingsFaqSectionPrivacySecurity": "Privacy & Security",
  "@settingsFaqSectionPrivacySecurity": {
    "description": "Help screen FAQ section heading."
  },
  "settingsFaq30Question": "How do I set up biometric lock?",
  "@settingsFaq30Question": {
    "description": "Help screen FAQ question (Privacy & Security)."
  },
  "settingsFaq30Answer": "Go to Settings > Privacy & Security and enable Biometric Lock. Once enabled, you'll need your fingerprint or face to open the app. You can also configure an auto-lock timer so the app locks after a period of inactivity.",
  "@settingsFaq30Answer": {
    "description": "Help screen FAQ answer to: How do I set up biometric lock?"
  },
  "settingsFaq31Question": "Is my financial data secure?",
  "@settingsFaq31Question": {
    "description": "Help screen FAQ question (Privacy & Security)."
  },
  "settingsFaq31Answer": "Yes. All your data is stored locally on your device. If you enable Cloud Sync, your data is encrypted during transfer. We never share your financial data with third parties. You can review our Privacy Policy in Settings > About.",
  "@settingsFaq31Answer": {
    "description": "Help screen FAQ answer to: Is my financial data secure?"
  },
