<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep financial data out of Google's cloud backup and out of
     device-to-device transfer. The stores are encrypted with a key that stays in
     this phone's keystore, so a copied store could not be opened anyway; a new
     phone gets its data back from sync or a Drive backup instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
